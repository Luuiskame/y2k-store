STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
# Redis — required in production for cache, event bus, workflow engine, locking.
# Leave UNSET locally to use the in-memory fallbacks (fine for dev).
# Format: redis[s]://[user][:password]@host[:port][/db]
# On Railway, append ?family=0 to the internal URL so ioredis accepts IPv6.
REDIS_URL=
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-v2

# Worker split — production runs two services (server + worker) sharing this repo.
# Local dev: leave unset (defaults to "shared" — single process does everything).
# Railway server service: MEDUSA_WORKER_MODE=server, DISABLE_MEDUSA_ADMIN=false
# Railway worker service: MEDUSA_WORKER_MODE=worker, DISABLE_MEDUSA_ADMIN=true
MEDUSA_WORKER_MODE=
DISABLE_MEDUSA_ADMIN=false
# Public URL of the deployed backend (used by the admin UI to know its own origin)
MEDUSA_BACKEND_URL=

# --- Rate limiting -----------------------------------------------------------
# Shared secret the storefront sends in `x-storefront-secret`. It is what tells
# this API "this request came from the shop, bucket it by `x-real-client-ip`
# (the visitor) and not by the Vercel egress address everything arrives from".
# Must be the SAME random string (32+ bytes) here, on the Railway worker, and
# in the Vercel project. Leave UNSET locally unless you are testing the split:
# when it is unset, storefront traffic is throttled as external — the shop still
# works, it is just protected less precisely. Never commit a real value.
STOREFRONT_SHARED_SECRET=

# How many proxies sit in front of this service, i.e. how many entries the edge
# appends to `x-forwarded-for`. The limiter reads the entry this far from the
# RIGHT. Default 1 (the rightmost). Do not change without re-measuring.
TRUSTED_PROXY_HOPS=

# Where the client address comes from: `xff` (default, read x-forwarded-for) or
# `cf` (read cf-connecting-ip). Set this to `cf` THE DAY the API's DNS moves
# behind Cloudflare: CF appends to x-forwarded-for instead of overwriting it,
# and without this flag the limiter becomes evadable.
CLIENT_IP_SOURCE=

# Cloudflare R2 (S3-compatible file storage)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FILE_URL=https://<your-public-r2-url-or-custom-domain>

# Meta (Facebook) Conversions API — server-side Purchase tracking.
# Leave the token UNSET to disable (the subscriber no-ops without it).
# See docs/meta-conversions-api.md for how to obtain these.
NEXT_PUBLIC_META_PIXEL_ID=            # pixel/dataset id (shared with the storefront)
META_CAPI_ACCESS_TOKEN=              # System User token with access to the pixel
META_CAPI_TEST_EVENT_CODE=           # optional; Events Manager > Test Events code
META_EVENT_SOURCE_URL=               # optional; storefront URL, e.g. https://y2kfit.hn
